{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@tablebite/db": ["../../packages/db/src"],
      "@tablebite/types": ["../../packages/types/src"],
      "@tablebite/qr": ["../../packages/qr/src"],
      "@tablebite/realtime": ["../../packages/realtime/src"]
    }
  },
  "include": ["src/**/*"]
}
